@startuml Potion Class

class User {
    +id: Long
    +username: String
    +email: String
    +password: String
    +active: Boolean
}

class Inventory {
    +id: Long
    +space: int
}

class InventoryItem {
    +id: Long
    +quantity: int
}

class Item {
    +id: Long
    +name: String
    +description: String
    +type: ItemType
    +maxStack: int
}

class Recipe {
    +id: Long
    +name: String
    +description: String
}

class RecipeIngredient {
    +id: Long
    +quantity: int
}

class UserRecipeDiscovery {
    +discoveredAt: LocalDateTime
}

User "1" --> "1" Inventory
Inventory "1" --> "*" InventoryItem
InventoryItem "*" --> "1" Item

Recipe "1" --> "1" Item : creates
Recipe "1" --> "*" RecipeIngredient
RecipeIngredient "*" --> "1" Item

User "1" --> "*" UserRecipeDiscovery
UserRecipeDiscovery "*" --> "1" Recipe

@enduml